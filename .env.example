# Скопируйте в .env и заполните значения
PORT=3000
NODE_ENV=production

# MariaDB
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=genesis
DB_PASSWORD=change_me
DB_NAME=genesis

# JWT / сессии
JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRES_IN=7d

# CORS (пусто = разрешить всё; на проде можно указать http://148.251.218.142)
CORS_ORIGIN=

# Ключ для Minecraft-мода (POST /api/mc/verify)
MOD_API_KEY=change_me_mod_key
