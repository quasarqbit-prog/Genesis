# Скопируйте в .env и заполните значения
PORT=3000
NODE_ENV=production

# MariaDB
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=genesis
DB_PASSWORD=change_me
DB_NAME=genesis

# JWT / сессии
JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRES_IN=7d

# CORS (пусто = разрешить всё; на проде можно указать http://148.251.218.142)
CORS_ORIGIN=

# Ключ для Minecraft-мода (POST /api/mc/verify)
MOD_API_KEY=change_me_mod_key

# Данные вкладки «Сервер»
SERVER_JOIN_PASSWORD=
SERVER_IP=srv1001.godlike.club:26519
SERVER_MC_VERSION=Minecraft 1.21.11 Fabric

# Google Drive: папка мода (anyone-with-link can edit в UI)
# https://drive.google.com/drive/folders/1SrkR-K4V-0wmdjGQeyCOsAIn6KSaeV-P
GDRIVE_MOD_FOLDER_ID=1SrkR-K4V-0wmdjGQeyCOsAIn6KSaeV-P
# Сервисный аккаунт Google Cloud (JSON одной строкой ИЛИ путь к файлу).
# Папку мода нужно расшарить этому email как Редактор.
# GDRIVE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"...","private_key":"...","client_email":"..."}
# GDRIVE_SERVICE_ACCOUNT_FILE=/var/www/mygame/secrets/gdrive-sa.json
# Либо OAuth refresh token владельца диска:
# GDRIVE_OAUTH_CLIENT_ID=
# GDRIVE_OAUTH_CLIENT_SECRET=
# GDRIVE_OAUTH_REFRESH_TOKEN=

# Сид админ-аккаунта (создаётся/обновляется при старте сервера)
ADMIN_TELEGRAM=@kunvutikmurmurmurrr
ADMIN_MC_NICK=DapRatt
ADMIN_ACCOUNT_TYPE=licensed
ADMIN_PASSWORD=ilovecuw

# Telegram Login Widget (BotFather → /setdomain на IP/домен сайта)
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
